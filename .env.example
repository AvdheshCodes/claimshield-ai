# =============================================================
# ClaimShield AI — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the actual .env file to version control.
# =============================================================

# ---- Server ----
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ---- MongoDB ----
# Local:  mongodb://localhost:27017/claimshield
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/claimshield
MONGODB_URI=mongodb://localhost:27017/claimshield

# ---- JWT Authentication ----
JWT_SECRET=replace_with_a_long_random_secret_min_32_chars
JWT_EXPIRES_IN=7d

# ---- File Upload ----
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads

# ---- Google Gemini API ----
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ---- OpenAI (fallback, optional) ----
OPENAI_API_KEY=your_openai_api_key_here

# ---- Risk Engine Weights (0–100 scale) ----
RISK_WEIGHT_DUPLICATE_INVOICE=35
RISK_WEIGHT_DUPLICATE_FILE=30
RISK_WEIGHT_POLICY_MISMATCH=25
RISK_WEIGHT_VEHICLE_MISMATCH=20
RISK_WEIGHT_DATE_CONFLICT=15
RISK_WEIGHT_AMOUNT_ANOMALY=20
RISK_WEIGHT_REPEATED_SUBMISSION=25
RISK_WEIGHT_MISSING_DOCUMENT=10

# ---- Demo Accounts (seeder) ----
DEMO_ADMIN_EMAIL=admin@claimshield.demo
DEMO_ADMIN_PASSWORD=Admin@123456
DEMO_OFFICER_EMAIL=officer@claimshield.demo
DEMO_OFFICER_PASSWORD=Officer@123456
DEMO_APPLICANT_EMAIL=applicant@claimshield.demo
DEMO_APPLICANT_PASSWORD=Applicant@123456
